<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding
                Light={StaticResource CanvasLight},
                Dark={StaticResource CanvasDark}}"
        />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding
                Light={StaticResource TextPrimary},
                Dark={StaticResource TextPrimaryDark}}"
        />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Entry">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding
                Light={StaticResource TextPrimary},
                Dark={StaticResource TextPrimaryDark}}"
        />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <Style TargetType="Editor">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding
                Light={StaticResource TextPrimary},
                Dark={StaticResource TextPrimaryDark}}"
        />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="112" />
    </Style>
</ResourceDictionary>
