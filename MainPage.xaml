<ContentPage
    x:Class="BudApka.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding
        Light={StaticResource CanvasLight},
        Dark={StaticResource CanvasDark}}"
>
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,Auto" RowSpacing="0" SafeAreaEdges="All">
        <ContentView x:Name="HeaderHost" Grid.Row="0" />
        <ContentView x:Name="BodyHost" Grid.Row="1" />
        <ContentView x:Name="NavigationHost" Grid.Row="2" HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
